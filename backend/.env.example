# =============================================================================
# My Online Market — environment variables (example)
# Bu faylni `.env` ga nusxalang va o'zingizning qiymatlaringizni qo'ying.
# .env GIT'ga commit qilinmaydi (.gitignore'da).
# =============================================================================

# ----- Django core -----
DJANGO_SECRET_KEY=change-me-to-50+-random-characters-from-openssl-rand
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_USE_TZ=True
TIME_ZONE=Asia/Tashkent

# ----- Database (PostgreSQL 16+) -----
# Format: postgres://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgres://mom:mom@localhost:5432/mom
DATABASE_CONN_MAX_AGE=60

# ----- Redis (cache + Celery broker) -----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# ----- Email -----
# Dev: console. Prod: SMTP/Mailgun/SES (django-anymail).
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@my-online-market.uz

# ----- Cloudinary (image CDN) -----
# Sign up at https://cloudinary.com (free tier).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----- SMS (Eskiz.uz) -----
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_SENDER=4546

# ----- Sentry (production) -----
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production
